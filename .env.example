# Copy to .env and fill in your own credentials. NEVER commit your real .env.
# These are the same credentials you log in to your prop firm's web platform with.

PROJECTX_USERNAME=your_username
PROJECTX_PASSWORD=your_password

# Optional: the account you want to trade (numeric account id).
# Leave blank to list accounts and pick one programmatically.
PROJECTX_ACCOUNT_ID=

# Firm preset selects the API endpoints. Default: topstepx.
# Supported presets live in pxtrader/config.py (add your firm's ProjectX gateway there).
PROJECTX_FIRM=topstepx
